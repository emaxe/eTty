<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- REQ-19 (задача #29): TerminalForegroundService держит процесс живым, пока есть активное
         SSH-соединение и приложение свёрнуто — без FGS Android агрессивно убивает background-
         процессы. FOREGROUND_SERVICE_CONNECTED_DEVICE — обязательная декларация типа службы на
         Android 14+ (API 34), без неё startForeground() с этим типом падает с
         MissingForegroundServiceTypeException. POST_NOTIFICATIONS — без неё на Android 13+ (API 33)
         нотификация службы не показывается, но сама служба продолжает работать (задокументированное
         поведение) — рантайм-запрос разрешения не реализован (нет permission-плагина в зависимостях
         проекта, см. `docs/plans/mob/plan.md`), поэтому на новых версиях Android пользователь не
         увидит нотификацию, хотя защита от kill сработает. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="eTty"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <service
            android:name=".TerminalForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
